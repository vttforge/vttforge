{
  "name": "@vttforge/testing",
  "version": "0.1.0",
  "description": "Quench-compatible test helpers and Foundry mocks for VTTForge systems and modules.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/vttforge/vttforge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vttforge/vttforge.git",
    "directory": "packages/testing"
  },
  "bugs": "https://github.com/vttforge/vttforge/issues",
  "keywords": [
    "foundryvtt",
    "testing",
    "quench",
    "vitest"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./vitest": {
      "types": "./dist/vitest/index.d.mts",
      "import": "./dist/vitest/index.mjs"
    },
    "./quench": {
      "types": "./dist/quench/index.d.mts",
      "import": "./dist/quench/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unrun": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  }
}
