{
  "name": "@vttforge/core",
  "version": "0.8.0",
  "description": "VTTForge core runtime: BaseTypeDataModel, BaseActorSheet, SystemConfig, registerSystem, error registry.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/vttforge/vttforge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vttforge/vttforge.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/vttforge/vttforge/issues",
  "keywords": [
    "foundryvtt",
    "foundry-vtt",
    "sdk",
    "typescript",
    "vtt"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "postbuild": "node ./scripts/codegen-errors.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "happy-dom": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unrun": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  }
}
