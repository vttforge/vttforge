{
  "name": "@vttforge/cli",
  "version": "0.5.4",
  "description": "Scaffold, dev loop, release build and audit for Foundry VTT v13+ systems and modules.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/vttforge/vttforge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vttforge/vttforge.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/vttforge/vttforge/issues",
  "keywords": [
    "foundryvtt",
    "cli",
    "scaffold"
  ],
  "bin": {
    "vttforge": "./dist/bin.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "templates",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "archiver": "catalog:",
    "citty": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@types/archiver": "catalog:",
    "@types/node": "catalog:",
    "@vttforge/dev-module": "workspace:*",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unrun": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  }
}
