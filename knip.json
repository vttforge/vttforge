{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {},
    "packages/*": {},
    "packages/cli": {
      "ignore": ["templates/**"]
    },
    "packages/create-vttforge": {},
    "packages/styles": {
      "entry": ["preview/index.html", "preview/preview.js"],
      "project": ["preview/**/*.js"]
    },
    "packages/vite-plugin": {
      "ignore": ["src/__tests__/fixtures/**"],
      "ignoreDependencies": ["@babel/plugin-proposal-decorators"]
    },
    "examples/simple-system": {
      "entry": ["scripts/main.mjs"],
      "project": ["scripts/**/*.mjs"],
      "ignoreDependencies": ["@vttforge/styles"]
    },
    "examples/simple-module": {
      "entry": ["scripts/main.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "apps/web": {
      "entry": ["index.html"],
      "ignoreDependencies": ["@vttforge/styles"]
    },
    "apps/docs": {
      "ignoreDependencies": [
        "typedoc-plugin-markdown",
        "typedoc-vitepress-theme",
        "@vttforge/styles"
      ]
    },
    "apps/e2e": {
      "entry": ["tests/*.spec.mjs"]
    },
    "packages/core": {
      "entry": ["src/**/*.test-d.ts"],
      "ignoreDependencies": ["@babel/plugin-proposal-decorators"]
    }
  }
}
